[Unit]
Description=Pulse Edge Collector
After=network-online.target bluetooth.target dbus.service k3s.service
Wants=network-online.target bluetooth.target k3s.service
Requires=bluetooth.service

[Service]
EnvironmentFile=/etc/pulse-edge/secret.env
Environment=GOMAXPROCS=1
Environment=GOMEMLIMIT=192MiB
Environment=GOGC=100
Environment=PULSE_EDGE_TRANSPORT=grpc
Environment=PULSE_EDGE_GRPC_ADDR=127.0.0.1:19090
ExecStart=/usr/local/bin/pulse-edge-collector -config /etc/pulse-edge/config.yaml
Restart=on-failure
RestartSec=5s
RestartPreventExitStatus=10
StartLimitIntervalSec=300
StartLimitBurst=12
RuntimeDirectory=pulse-edge
RuntimeDirectoryMode=0750
StateDirectory=pulse-edge
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/pulse-edge /var/lib/pulse-edge
MemoryMax=256M
LimitNOFILE=4096
KillSignal=SIGTERM
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target
